# crypto-quant-app 生产环境配置模板 — 复制到编排目录的 .env 后填实际值
# 配套 docker-compose.prod.yml 用 (1Panel 容器编排 / VPS)
# ⚠️ 切勿把填好真实秘钥的 .env 提交到 git

# ========== 应用配置 ==========
APP_NAME=CryptoQuant
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production

# ========== 安全密钥 (必填,各生成一次) ==========
# 各 64 位 hex, 跑: openssl rand -hex 32
SECRET_KEY=
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256

# ========== 管理员账户 (单用户登录) ==========
ADMIN_USERNAME=your-email@example.com
# 跑下面命令生成,把输出粘到这里:
#   docker compose -f docker-compose.prod.yml run --rm backend python -m scripts.generate_admin_hash
ADMIN_PASSWORD_HASH=

# ========== 数据库 / Redis 密码 (必填强密码) ==========
# DATABASE_URL / REDIS_URL 不用写,compose 从这两个密码自动拼出
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# ========== Token 过期 ==========
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ========== CORS (必填你的公网域名) ==========
# 多个用逗号分隔; 必须 https,反代后浏览器拿的就是 https
CORS_ORIGINS=https://your-domain.example.com

# ========== 交易所 API (可选,也可在 Web 设置抽屉填) ==========
BINANCE_API_KEY=
BINANCE_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

# ========== 自停 / 异常告警阈值 (默认值通常够用) ==========
AUTO_PAUSE_CONSECUTIVE_ERRORS=5
AUTO_PAUSE_CONSECUTIVE_ORDER_FAILURES=3
AUTO_PAUSE_HEARTBEAT_MULTIPLIER=5
AUTO_PAUSE_HEARTBEAT_MIN_SECONDS=300
AUTO_PAUSE_WATCHDOG_INTERVAL_SECONDS=30

# ========== 告警通道 (至少配一个,留空即跳过) ==========
# Telegram (即时,需 VPS 能访问 telegram.org)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 邮箱 SMTP (国内通用兜底; QQ/163/Gmail 均可,密码用「授权码」)
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_USE_TLS=true
